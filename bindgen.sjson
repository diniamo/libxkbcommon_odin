inputs = [ "headers/xkbcommon" ]
output_folder = "."

import_lib = "system:xkbcommon"
imports_file = ""
package_name = "xkbcommon"

remove_type_prefix = "xkb_"
remove_macro_prefix = "XKB_"
remove_function_prefix = "xkb_"
remove_type_suffix = "_t"
force_ada_case_types = true
procedures_at_end = false

rename = {}
bit_setify = {}
type_overrides = { "FILE" = "c.FILE" }
struct_field_overrides = {}
struct_field_tags = {}
remove_enum_members = []
remove_enum_member_prefix = {}
procedure_type_overrides = {}
procedure_parameter_defaults = {}
remove = []
clang_include_paths = [ "headers" ]
clang_defines = {}
